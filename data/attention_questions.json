  "repairs": {
    "response_format": {
      "explanation": "The tested operations worked. The initial reply contained one component, so practice reporting the full vector. This does not establish why you omitted a component.",
      "example": "A vector whose first component is 2 and second is 3 is written [2,3].",
      "connection": "An attention output contains every component of the mixed value vectors."
    },
    "scalar_multiplication": {
      "explanation": "Multiply every component by the scalar.",
      "example": "0.5 \u00d7 [6,4] = [3,2].",
      "connection": "An attention weight scales every coordinate of its value vector."
    },
    "vector_addition": {
      "explanation": "Add matching components; preserve the vector shape.",
      "example": "[2,1]+[3,4]=[5,5].",
      "connection": "Attention adds the scaled value vectors coordinate by coordinate."
    },
    "weighted_sums": {
      "explanation": "Scale each value by its own weight, then add matching components.",
      "example": "0.25\u00d7[8,0]+0.75\u00d7[0,4]=[2,0]+[0,3]=[2,3].",
      "connection": "This mixes information from value vectors according to attention weights."
    },
    "tensor_shapes": {
      "explanation": "Swapping axes exchanges those positions in the shape, not the values of every dimension.",
      "example": "(2,3,4), swap axes 0 and 1: (3,2,4).",
      "connection": "Attention masks and score tensors must refer to matching axes."
    },
    "broadcasting": {
      "explanation": "Broadcasting aligns trailing dimensions. Corresponding dimensions must match or be one.",
      "example": "A vector of shape (4,) broadcasts over (2,3,4); a vector of shape (3,) does not.",
      "connection": "A mask must align with the intended query or key dimension."
    },
    "notation_to_code": {
      "explanation": "Write the output axis order explicitly before choosing a transpose operation.",
      "example": "For original axes [0,1,2], swapping the first two produces [1,0,2].",
      "connection": "An attention formula does not automatically specify the correct tensor-axis order in code."
    },
    "writing_claim": {
      "explanation": "A main point states the idea the paragraph asks the reader to accept; a detail only describes something.",
      "example": "There are trees in the playground is a detail. Schools should plant more shade trees is a main point.",
      "connection": "Choose the point first, then add details that support it."
    },
    "writing_evidence": {
      "explanation": "Choose a detail that gives a reason to accept the point. An interesting detail can still be irrelevant.",
      "example": "For more playground shade, shaded surfaces staying cooler is useful evidence; rough tree bark is not.",
      "connection": "Explain why that relevant detail supports your main point."
    },
    "writing_link": {
      "explanation": "After giving evidence, explain why it supports your main point. Do not just add another fact.",
      "example": "Point: More shade makes playgrounds comfortable. Evidence: Shade keeps surfaces cooler. Link: Cooler surfaces let students play without overheating.",
      "connection": "Use point, evidence, then a sentence explaining their connection in your next paragraph."
    }
  }
